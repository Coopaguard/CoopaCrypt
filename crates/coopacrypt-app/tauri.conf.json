{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoopaCrypt",
  "version": "0.2.0",
  "identifier": "app.coopaguard.coopacrypt",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../app"
    }
  },
  "app": {
    "windows": [
      {
        "title": "CoopaCrypt",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
