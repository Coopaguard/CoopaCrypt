{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoopaCrypt",
  "version": "2.1.0",
  "identifier": "app.coopaguard.coopacrypt",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../../app"
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../app"
    }
  },
  "app": {
    "windows": [
      {
        "title": "CoopaCrypt",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Coopaguard/CoopaCrypt/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZFMkQ1MUI2NEI2MUE0OQpSV1JKR3Jaa0c5WGlCczM3dkRLN0RZMmJVZmdvanpQaDF0VXdUZ1RVak5mdWtsa0RZbGhCNnY1bAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["coocrypt"],
        "name": "CoopaCrypt.Vault",
        "description": "Coffre CoopaCrypt",
        "role": "Editor",
        "mimeType": "application/x-coocrypt"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
