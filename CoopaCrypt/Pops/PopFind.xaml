<Window x:Class="CoopaCrypt.Pops.PopFind"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoopaCrypt.Pops"
        mc:Ignorable="d"
        Title="Rechercher / Remplacer" Height="160" Width="400"
        Closing="Window_Closing" WindowStyle ="ToolWindow">
    <Border BorderThickness="1,0,1,1" BorderBrush="Black">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90"></ColumnDefinition>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="100"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>
            <!--<Button Grid.Column="2" Content="X" Background="Red" Margin="0,-7,-7,0" Height="20" 
                    Width="20" Panel.ZIndex="10" VerticalAlignment="Top" HorizontalAlignment="Right"
                    x:Name="BtnClose" Click="BtnClose_Click"></Button>-->
            
            <Label VerticalAlignment="Center" Margin="5">Rechercher:</Label>
            <TextBox x:Name="TbFind" VerticalAlignment="Center" Grid.Column="1" Margin="5"></TextBox>
            <Button x:Name="BtnFind" Click="BtnFind_Click" Grid.Column="2" VerticalAlignment="Center" Content="Trouver" Margin="5,5,5,5"></Button>

            <Label VerticalAlignment="Top" Grid.Row="1" Margin="5">Remplacer:</Label>
            <TextBox x:Name="TbReplace" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1" Margin="5"></TextBox>
            <Button x:Name="BtnReplace" Click="BtnReplace_Click" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Content="Remplacer 1" Margin="5,5,5,5"></Button>
            <Button x:Name="BtnReplaceAll" Click="BtnReplaceAll_Click" Grid.Row="2" Grid.Column="2" VerticalAlignment="Top" Content="Remplacer tous" Margin="5,5,5,5"></Button>

            <CheckBox x:Name="CbCaseSensitive" Grid.Row="2" Grid.Column="1" Content="Sensible à la casse" IsChecked="False" VerticalAlignment="Top" 
                  HorizontalAlignment="Left" Margin="5"></CheckBox>

            <!--<Label Grid.Row="2" VerticalAlignment="Bottom">opacité</Label>
            <Slider x:Name="SOpacity" Grid.Row="2" Grid.Column="1" Maximum="1" Minimum="0.1" VerticalAlignment="Bottom" ValueChanged="SOpacity_ValueChanged" Margin="5,0,5,5"/>-->
        </Grid>
    </Border>
</Window>
