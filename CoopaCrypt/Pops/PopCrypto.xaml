<Window x:Class="CoopaCrypt.Pops.PopCrypto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CoopaCrypt.Pops"
        mc:Ignorable="d"
        Title="Saisie de mot de passe" Height="80" Width="350" ResizeMode="NoResize" Closing="Window_Closing"
        WindowStyle="None">
    <Border BorderThickness="1" BorderBrush="Black">
        <Grid>
            <Label Width="90" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">Mot de passe:</Label>
            <PasswordBox x:Name="TbPwd" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="100,5,0,0" Width="200" Height="25" KeyDown="TbPwd_KeyDown"></PasswordBox>
            <Button x:Name="cancelBtn" Height="25" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="left" Margin="5,35,5,5" Content="Cancel" Click="cancelBtn_Click"></Button>
            <Button x:Name="OkButton" Height="25" Width="100" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="5,35,5,5" Content="Ok" Click="OkButton_Click"></Button>
        </Grid>
    </Border>
</Window>
